# devflow settings. Copy to .env (git-ignored) and fill in what you use.
# `bun run devflow ...` loads .env from the repository root. Everything else (ports, database,
# keys, origins) is generated in ~/.devflow; see `bun run devflow env`.

# Claude subscription token from `claude setup-token`. Required for the Docker agent sandbox and on
# Linux/AWS; on macOS without the sandbox, the Keychain login from `claude` is used instead.
CLAUDE_CODE_OAUTH_TOKEN=

# Where agents run when their project does not pick (Settings → Projects → Sandbox): `docker` (a
# container per session, default), `vm` (the host's shared Lima VM) or `none` (on the host).
# DEVFLOW_AGENT_SANDBOX=docker

# Lima VMs for projects whose sandbox is `vm` (agents get Docker and a whole Ubuntu inside).
# Each VM is a full copy of a provisioned base disk, so watch free disk space.
# DEVFLOW_VM_CPUS=4
# DEVFLOW_VM_MEMORY_GIB=8
# DEVFLOW_VM_DISK_GIB=60
# Stop a VM this long after its last session ends (0 keeps it running).
# DEVFLOW_VM_IDLE_STOP_MINUTES=60

# GitHub token for sandboxed agents (git push, `gh pr create`). Defaults to `gh auth token`.
# GH_TOKEN=

# Encrypts the GitHub accounts stored in Settings → GitHub accounts (32 random bytes, base64:
# `openssl rand -base64 32`). `bun run devflow` generates it into .env once when unset; changing
# it makes stored tokens unreadable, so the accounts must be added again.
# GITHUB_ACCOUNT_TOKEN_KEY=

# Your own GitHub App, only for the GitHub issue picker and PR status in the UI.
# Without these, agents still push and open PRs with gh.
# GITHUB_APP_ID=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Config, keys, logs and the sandbox's Claude config directory.
# DEVFLOW_HOME=~/.devflow

# Caddy ports for https://{app,api,sync,s3}.devflow.localhost:<port>.
# DEVFLOW_HTTPS_PORT=47443
# DEVFLOW_HTTP_PORT=47080

# Agent sandbox image (built from docker/devflow-agent on first `setup`/`up`).
# DEVFLOW_AGENT_IMAGE=devflow-agent:latest
