{
  "name": "devflow",
  "devDependencies": {
    "@devflow/vitest-config": "workspace:*",
    "@durable-streams/cli": "catalog:",
    "@effect/tsgo": "0.36.4",
    "@electric-sql/pglite": "catalog:",
    "@oxlint/plugins": "1.77.0",
    "@socketsecurity/bun-security-scanner": "1.1.2",
    "@types/aws-lambda": "8.10.156",
    "@types/bun": "^1.3.10",
    "@types/node": "^25.3.5",
    "node-gyp": "12.4.0",
    "oxfmt": "0.54.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "react-doctor": "0.9.13",
    "rimraf": "^6.0.1",
    "tsx": "4.23.9",
    "turbo": "2.8.1",
    "typescript": "7.0.2",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14",
  "private": true,
  "scripts": {
    "devflow": "bun apps/launcher/src/devflow.ts",
    "build": "turbo run build",
    "lint": "oxlint apps packages contracts",
    "lint:fix": "oxlint apps packages contracts --fix --quiet",
    "format": "oxfmt --check 'apps/**/*.ts*' 'packages/**/*.ts*' 'contracts/**/*.ts*'",
    "format:write": "oxfmt 'apps/**/*.ts*' 'packages/**/*.ts*' 'contracts/**/*.ts*'",
    "quality": "bun run scripts/run-silent.ts 'quality passed' bash -c 'oxlint --quiet apps packages contracts && bun run format'",
    "quality:fix": "bun run lint:fix && bun run format:write",
    "check": "bun run typecheck && bun run quality && bun run check:zod",
    "check:zod": "bun run scripts/check-zod-version.ts",
    "test": "bun run scripts/run-silent.ts 'tests passed' bun run test:local",
    "test:local": "bun run test:ci:unit && bun run test:local:services",
    "test:local:services": "bash -c \"set -euo pipefail; bun scripts/test-services-up.ts; trap 'bun scripts/test-services-down.ts' EXIT; bun scripts/test-services-wait.ts; bun --env-file=.env turbo run test --filter='@devflow/api' --filter='@devflow/test-fixtures' --filter='@devflow/sync-proxy' --filter='@devflow/session-sweeper' --concurrency=3; bun --env-file=.env vitest run --config apps/agent-runner/vitest.config.ts --project database\"",
    "test:ci": "bun run test:ci:unit && bun run test:ci:services",
    "test:ci:unit": "bun --env-file=.env turbo run test --filter='!@devflow/api' --filter='!@devflow/test-fixtures' --filter='!@devflow/sync-proxy' --filter='!@devflow/session-sweeper'",
    "test:ci:services": "bash -c \"set -euo pipefail; bun scripts/test-services-up.ts; trap 'bun scripts/test-services-down.ts' EXIT; bun scripts/test-services-wait.ts; bun scripts/test-services-run.ts\"",
    "test:services:up": "bun scripts/test-services-up.ts",
    "test:services:wait": "bun scripts/test-services-wait.ts",
    "test:services:down": "bun scripts/test-services-down.ts",
    "typecheck": "bun run scripts/run-silent.ts 'typecheck passed' turbo run typecheck",
    "db:migrations:generate": "bun --cwd packages/db drizzle-kit generate",
    "hook:quality": "bun run quality",
    "hook:typecheck": "turbo run typecheck",
    "hook:prepush": "bun scripts/hook-prepush.ts && bunx react-doctor apps/web --scope changed --blocking warning",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "dev:setup": "bun run prepare",
    "test:scripts": "bun vitest run",
    "test:anti-slop": "node --import tsx tools/oxlint/automation/rules/prefer-use-mount-effect.test.ts && node --import tsx tools/oxlint/automation/layer-provide-rules.test.ts && node --import tsx tools/oxlint/anti-slop/rules/max-ternary-depth.test.ts && node --import tsx tools/oxlint/anti-slop/rules/no-chained-type-assertions.test.ts && node --import tsx tools/oxlint/anti-slop/rules/no-conditional-spread.test.ts && node --import tsx tools/oxlint/anti-slop/rules/no-known-value-widening.test.ts && node --import tsx tools/oxlint/anti-slop/rules/no-object-parameters.test.ts && node --import tsx tools/oxlint/anti-slop/rules/no-reprovide-ambient-service.test.ts && node --import tsx tools/oxlint/anti-slop/rules/no-unknown-type-aliases.test.ts && node --import tsx tools/oxlint/anti-slop/rules/no-widen-then-assert.test.ts"
  },
  "workspaces": [
    "apps/*",
    "contracts/*",
    "packages/*",
    "vendor/*"
  ],
  "catalog": {
    "zod": "4.5.4",
    "@orpc/contract": "1.14.3",
    "@orpc/zod": "1.14.3",
    "@orpc/openapi": "1.14.3",
    "@orpc/openapi-client": "1.14.3",
    "@orpc/server": "1.14.3",
    "@orpc/client": "1.14.3",
    "@orpc/otel": "1.14.3",
    "@orpc/tanstack-query": "1.14.3",
    "drizzle-orm": "0.45.0",
    "drizzle-kit": "0.31.8 ",
    "catalog": "0.45.0",
    "pg": "8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.1.9",
    "typescript": "7.0.2",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.9.1",
    "@tanstack/db": "0.9.2",
    "@tanstack/react-db": "0.4.1",
    "@tanstack/electric-db-collection": "0.4.10",
    "@electric-sql/client": "1.5.28",
    "@electric-sql/react": "1.0.57",
    "@electric-sql/pglite": "0.5.4",
    "@tanstack/query-core": "5.101.0",
    "@tanstack/query-db-collection": "1.2.15",
    "@tanstack/react-query": "5.101.0",
    "@tanstack/react-query-devtools": "5.101.0",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/router-plugin": "1.168.35",
    "@tanstack/match-sorter-utils": "8.19.4",
    "@tanstack/react-store": "0.9.2",
    "@tanstack/devtools-event-client": "0.4.3",
    "@tanstack/devtools-vite": "0.7.0",
    "@tanstack/react-devtools": "0.9.13",
    "@tanstack/react-table": "8.21.3",
    "@durable-streams/cli": "0.2.7",
    "@durable-streams/client": "0.2.7",
    "@durable-streams/state": "0.3.2",
    "@durable-streams/server": "0.3.9",
    "yjs": "13.6.32",
    "y-protocols": "1.0.7",
    "lib0": "0.2.114",
    "@tiptap/extension-collaboration": "3.22.5",
    "@tiptap/extension-collaboration-caret": "3.22.5",
    "@tiptap/y-tiptap": "3.0.2",
    "effect": "4.0.0",
    "@effect/opentelemetry": "4.0.0",
    "@effect/platform-browser": "4.0.0",
    "@effect/platform-node": "4.0.0",
    "@effect/platform-bun": "4.0.0",
    "@effect/vitest": "4.0.0",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@tiptap/core": "3.22.5",
    "@tiptap/extension-blockquote": "3.22.5",
    "@tiptap/extension-bold": "3.22.5",
