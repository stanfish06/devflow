#!/bin/bash
# devflow host bootstrap. cloud-init runs this once, as root, on first boot.
# Log: /var/log/devflow-bootstrap.log. /opt/devflow/.bootstrapped marks success.
set -euo pipefail
exec > >(tee -a /var/log/devflow-bootstrap.log) 2>&1

export DEBIAN_FRONTEND=noninteractive
BUN_VERSION='${bun_version}'
NODE_VERSION='${node_version}'
SWAP_GIB='${swap_gib}'
DEVFLOW_PATH=/home/devflow/.bun/bin:/usr/local/bin:/usr/bin:/bin

case "$(uname -m)" in
aarch64) AWS_ARCH=aarch64 NODE_ARCH=arm64 ;;
x86_64) AWS_ARCH=x86_64 NODE_ARCH=x64 ;;
*) echo "unsupported architecture: $(uname -m)" >&2 && exit 1 ;;
esac

# Swap so a UI build or agent spike does not OOM-kill Postgres.
if [ "$SWAP_GIB" -gt 0 ] && [ ! -f /swapfile ]; then
  fallocate -l "$SWAP_GIB"G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >>/etc/fstab
fi

apt-get update
# lsof and caddy: `devflow up` checks ports with lsof and runs its own Caddy.
apt-get install -y docker.io docker-compose-v2 git curl unzip jq caddy lsof xz-utils ca-certificates
# The packaged Caddy service listens on :80 and is not used.
systemctl disable --now caddy
systemctl enable --now docker

# AWS CLI v2 for the deploy script (S3 download, SSM parameters).
tmp=$(mktemp -d)
curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-$AWS_ARCH.zip" -o "$tmp/awscliv2.zip"
unzip -q "$tmp/awscliv2.zip" -d "$tmp"
"$tmp/aws/install" --update
rm -rf "$tmp"

# Node.js for CLIs whose entry point is `#!/usr/bin/env node` (codex) and install scripts.
tmp=$(mktemp -d)
node_file="node-v$NODE_VERSION-linux-$NODE_ARCH.tar.xz"
curl -fsSL "https://nodejs.org/dist/v$NODE_VERSION/$node_file" -o "$tmp/$node_file"
curl -fsSL "https://nodejs.org/dist/v$NODE_VERSION/SHASUMS256.txt" | grep "  $node_file\$" | (cd "$tmp" && sha256sum -c -)
rm -rf /opt/node && mkdir -p /opt/node
tar -xJf "$tmp/$node_file" -C /opt/node --strip-components=1
ln -sf /opt/node/bin/node /opt/node/bin/npm /opt/node/bin/npx /usr/local/bin/
rm -rf "$tmp"

id devflow >/dev/null 2>&1 || useradd --create-home --shell /bin/bash --groups docker devflow
mkdir -p /opt/devflow/bin

# ---- /opt/devflow/bin/install-bun <version> -----------------------------------
cat >/opt/devflow/bin/install-bun <<'SCRIPT'
#!/bin/bash
# Install bun <version> for the devflow user unless it is already installed.
set -euo pipefail
version="$1"
current=$(sudo -u devflow -H /home/devflow/.bun/bin/bun --version 2>/dev/null || true)
[ "$current" = "$version" ] && exit 0
sudo -u devflow -H bash -c "curl -fsSL https://bun.sh/install | bash -s bun-v$version"
SCRIPT

# ---- /opt/devflow/bin/deploy ----------------------------------------------------
cat >/opt/devflow/bin/deploy <<'SCRIPT'
#!/bin/bash
# Install s3://${bucket}/devflow.tar.gz into /opt/devflow/app, refresh secrets from SSM
# ${ssm_path}/*, and restart devflow.service. Run as root (SSM Run Command or a session).
# /home/devflow/.devflow (config, keys, logs) and Docker volumes are never touched.
set -euo pipefail
exec 9>/run/devflow-deploy.lock
flock -n 9 || { echo "another deploy is running" >&2; exit 1; }
[ -f /opt/devflow/.bootstrapped ] || { echo "bootstrap has not finished; see /var/log/devflow-bootstrap.log" >&2; exit 1; }

BUCKET='${bucket}'
REGION='${region}'
SSM_PATH='${ssm_path}'
APP=/opt/devflow/app
STAGE=/opt/devflow/app.next
PREV=/opt/devflow/app.prev
as_devflow() { sudo -u devflow -H env PATH=/home/devflow/.bun/bin:/usr/local/bin:/usr/bin:/bin "$@"; }

echo "==> download s3://$BUCKET/devflow.tar.gz"
rm -rf "$STAGE" && mkdir -p "$STAGE"
aws s3 cp --region "$REGION" --only-show-errors "s3://$BUCKET/devflow.tar.gz" /opt/devflow/devflow.tar.gz
tar -xzf /opt/devflow/devflow.tar.gz -C "$STAGE"
rm -f /opt/devflow/devflow.tar.gz
chown -R devflow:devflow "$STAGE"

# bun version from the bundle's packageManager ("bun@x.y.z").
bun_version=$(jq -r '.packageManager // "" | sub("^bun@"; "")' "$STAGE/package.json")
[ -n "$bun_version" ] && /opt/devflow/bin/install-bun "$bun_version"

echo "==> secrets from $SSM_PATH/"
raw=$(mktemp)
out=$(mktemp)
trap 'rm -f "$raw" "$out"' EXIT
aws ssm get-parameters-by-path --region "$REGION" --path "$SSM_PATH" --with-decryption --output json >"$raw"
# EnvironmentFile cannot hold multi-line values; fail instead of writing a broken file.
multiline=$(jq -r '.Parameters[] | select(.Value | contains("\n")) | .Name' "$raw")
[ -z "$multiline" ] || { echo "multi-line SSM values are not supported: $multiline" >&2; exit 1; }
skipped=$(jq -r '.Parameters[] | .Name | select(split("/") | last | test("^[A-Za-z_][A-Za-z0-9_]*$") | not)' "$raw")
[ -z "$skipped" ] || echo "skipped (basename is not an env var name): $skipped" >&2
jq -r '.Parameters[] | (.Name | split("/") | last) as $key
  | select($key | test("^[A-Za-z_][A-Za-z0-9_]*$")) | "\($key)=\(.Value)"' "$raw" >"$out"
install -m 600 -o root -g root "$out" /opt/devflow/secrets.env
echo "wrote $(wc -l <"$out") keys: $(cut -d= -f1 "$out" | paste -sd' ' -)"

echo "==> swap tree (previous kept at $PREV)"
systemctl stop devflow || true
rm -rf "$PREV"
[ -d "$APP" ] && mv "$APP" "$PREV"
mv "$STAGE" "$APP"

echo "==> bun install"
(cd "$APP" && as_devflow bun install)

if [ ! -f /home/devflow/.devflow/config.json ]; then
  echo "==> devflow setup (first deploy)"
  (cd "$APP" && as_devflow bun run devflow setup)
fi

systemctl restart devflow
echo "==> devflow.service restarted; logs: journalctl -u devflow -f"
SCRIPT
chmod 755 /opt/devflow/bin/install-bun /opt/devflow/bin/deploy

# ---- devflow.service ------------------------------------------------------------
cat >/etc/systemd/system/devflow.service <<UNIT
[Unit]
Description=devflow (headless)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
# Nothing to run until the first deploy.
ConditionPathExists=/opt/devflow/app/package.json

[Service]
User=devflow
WorkingDirectory=/opt/devflow/app
Environment=PATH=$DEVFLOW_PATH
EnvironmentFile=-/opt/devflow/secrets.env
ExecStart=/home/devflow/.bun/bin/bun run devflow up --headless
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable devflow

# ---- bun and agent CLIs for the devflow user ------------------------------------
/opt/devflow/bin/install-bun "$BUN_VERSION"
# claude-code's postinstall copies its native binary; bun trusts it by default.
sudo -u devflow -H env PATH="$DEVFLOW_PATH" bun add -g @anthropic-ai/claude-code @openai/codex
sudo -u devflow -H env PATH="$DEVFLOW_PATH" bash -c 'claude --version && codex --version'

touch /opt/devflow/.bootstrapped
echo "devflow bootstrap done"
