{
  "name": "@devflow/api",
  "version": "0.0.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "exports": {
    "./test-factory": "./test/test-factory.ts"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node --format esm --sourcemap=linked --minify --entry-naming '[name].mjs'",
    "dev": "bun --bun --env-file=../../.env run --watch src/index.ts",
    "dev:node-proxy": "bun --bun --env-file=../../.env run --watch src/index.ts",
    "build:macos": "bun run build",
    "build:linux": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun --env-file=../../.env vitest run --project unit --project unit-isolated",
    "test:llm": "bun run ../../scripts/run-silent.ts 'tests passed' bun run test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.7",
    "@ai-sdk/openai": "3.0.46",
    "@ai-sdk/provider": "3.0.10",
    "@aws-sdk/client-s3": "^3.1004.0",
    "@aws-sdk/s3-request-presigner": "^3.1004.0",
    "@devflow/ai": "workspace:*",
    "@devflow/db": "workspace:*",
    "@devflow/git-attribution": "workspace:*",
    "@devflow/logger": "workspace:*",
    "@devflow/api-contract": "workspace:*",
    "@devflow/test-fixtures": "workspace:*",
    "@distilled.cloud/aws": "1.0.0-rc.13",
    "@durable-streams/client": "catalog:",
    "@effect/opentelemetry": "catalog:",
    "@effect/platform-node": "catalog:",
    "@hono/node-server": "^1.14.1",
    "@devflow/effect-orpc": "workspace:*",
    "@devflow/schemas": "workspace:*",
    "@devflow/streams": "workspace:*",
    "@opentelemetry/api-logs": "0.218.0",
    "@opentelemetry/resources": "2.7.1",
    "@opentelemetry/sdk-logs": "0.218.0",
    "@opentelemetry/sdk-metrics": "2.7.1",
    "@opentelemetry/sdk-trace-base": "2.7.1",
    "@opentelemetry/sdk-trace-node": "2.7.1",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/otel": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "buffer": "6.0.3",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "hono": "^4.10.1",
    "http-status-codes": "^2.3.0",
    "jose": "^6.1.0",
    "ohash": "^2.0.11",
    "p-limit": "7.3.0",
    "postgres": "^3.4.8",
    "uuidv7": "^1.2.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@devflow/vitest-config": "workspace:*",
    "@durable-streams/server": "catalog:",
    "@durable-streams/state": "catalog:",
    "@effect/vitest": "catalog:",
    "@octokit/graphql-schema": "15.26.1",
    "@tanstack/db": "catalog:",
