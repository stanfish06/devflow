{
  "name": "@devflow/cli",
  "license": "MIT",
  "version": "0.40.0",
  "description": "devflow CLI — daemon management and authentication",
  "type": "module",
  "bin": {
    "devflow": "bin/devflow"
  },
  "files": [
    "bin/devflow",
    "README.md"
  ],
  "scripts": {
    "build": "bun run ./build.ts",
    "build:all": "bun run ./build.ts --all",
    "start": "NODE_USE_SYSTEM_CA=1 bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun vitest run"
  },
  "optionalDependencies": {
    "@devflow/cli-darwin-arm64": "0.3.0",
    "@devflow/cli-darwin-x64": "0.3.0",
    "@devflow/cli-linux-arm64": "0.3.0",
    "@devflow/cli-linux-x64": "0.3.0",
    "@devflow/cli-win32-x64": "0.3.0"
  },
  "dependencies": {
    "@devflow/api-contract": "workspace:*",
    "@devflow/agent-runner": "workspace:*",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/openapi-client": "catalog:",
    "@orpc/server": "catalog:",
    "commander": "^14.0.0",
    "effect": "catalog:",
    "trpc-cli": "^0.14.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@devflow/vitest-config": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@devflow/effect-proper-lockfile": "workspace:*",
    "@types/bun": "^1.3.4",
    "vitest": "catalog:"
  }
}
